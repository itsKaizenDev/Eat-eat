+/* Fokus: satu bahasa visual untuk menu, dialog, dan panel permainan. */
+:root { --paper:#f7f6ee; --surface:#fffef8; --ink:#253e31; --muted:#667367; --line:#dce2d4; --green:#315f42; }
+html,body { background:var(--paper); color:var(--ink); font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; touch-action:pan-y; }
+body { padding: max(16px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(16px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left)); }
+button,a,summary { -webkit-tap-highlight-color:transparent; }
+button { cursor:pointer; }
+button:disabled { cursor:not-allowed; opacity:.5; }
+button:focus-visible,a:focus-visible,summary:focus-visible { outline:3px solid #487b54; outline-offset:4px; }
+button { transition:background .18s,color .18s,transform .18s; }
+button:active:not(:disabled) { transform:translateY(1px); }
+.focus-stage { max-width:1000px; margin:auto; }
+.focus-stage #wrap { width:100%; border:0; border-radius:0; overflow:visible; box-shadow:none; }
+.canvas-sleep { display:none; }
+.focus-menu { width:100%; text-align:left; }
+.focus-header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:12px 0 24px; }
+.brand { display:flex; align-items:center; font-family:'Fredoka',ui-rounded,system-ui,sans-serif; font-size:29px; font-weight:600; letter-spacing:-1px; text-decoration:none; white-space:nowrap; }
+.brand img { width:38px; height:38px; object-fit:contain; margin-right:7px; }
+.brand span,.focus-loading b span { color:#88a75e; }
+.menu-tabs { display:flex; border:1px solid var(--line); border-radius:999px; background:#eeefe6; padding:4px; }
+.menu-tabs button { min-height:44px; padding:0 20px; border-radius:999px; font-size:13px; font-weight:650; color:var(--muted); }
+.menu-tabs button[aria-pressed=true] { color:var(--ink); background:var(--surface); box-shadow:0 1px 4px #253e3110; }
+.icon-button { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; border:1px solid var(--line); border-radius:50%; color:var(--ink); background:var(--surface); flex-shrink:0; }
+.menu-hero { position:relative; height:300px; overflow:hidden; isolation:isolate; border-radius:24px; background:#254c3a; }
+.focus-scene { position:absolute; inset:0; pointer-events:none; }
+.focus-scene picture { display:block; height:100%; animation:scene-in .35s ease-out; }
+.focus-scene img { height:100%; width:100%; object-fit:contain; object-position:right center; mask-image:linear-gradient(90deg,transparent,black 24%); animation:scene-drift 18s ease-in-out infinite alternate; }
+.hero-copy { position:absolute; inset:0; padding:40px; display:flex; flex-direction:column; justify-content:center; align-items:flex-start; color:#fffef5; max-width:55%; }
+.eyebrow { text-transform:uppercase; letter-spacing:.13em; font-size:10px; font-weight:750; }
+.hero-copy h1 { font-family:'Fredoka',ui-rounded,system-ui,sans-serif; font-weight:600; font-size:clamp(30px,4.5vw,54px); line-height:1.06; letter-spacing:-1px; margin:12px 0 20px; text-wrap:balance; }
+.hero-tag { display:inline-flex; border:1px solid #ffffff42; padding:6px 10px; border-radius:999px; font-size:11px; background:#173d2a45; }
+.menu-fieldset { min-width:0; margin:0; padding:0; border:0; }
+.focus-stage .start-menu { width:100%; max-width:none; padding:28px 0 0; background:none; border:0; box-shadow:none; border-radius:0; color:var(--ink); text-align:left; }
+.focus-stage .arc-cols,.focus-stage .adv-cols { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:36px; }
+.focus-stage .arc-set { display:flex; flex-direction:column; padding-left:32px; border-left:1px solid var(--line); }
+.start-menu-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:13px; font-weight:700; margin:0 0 12px; color:var(--ink); }
+.start-menu-heading > :last-child:not(:first-child) { font-size:11px; font-weight:500; color:var(--muted); }
+.focus-stage .start-groups { display:flex; gap:4px; padding:4px; margin:0 0 12px; border-radius:14px; background:#e9ede3; }
+.focus-stage .mode-group { display:flex; flex:1; flex-direction:row; justify-content:center; align-items:center; gap:6px; min-height:44px; border:0; padding:8px 6px; border-radius:10px; font-size:13px; font-weight:650; color:var(--muted); background:none; box-shadow:none; }
+.focus-stage .mode-group.active { color:var(--ink); background:var(--surface); box-shadow:0 1px 4px #253e3112; }
